# Render backend only. Copy to .env for local development. Never commit real keys.
GEMINI_API_KEY=
# Verify that YOUR key has access to these models using scripts/check_gemini.py.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Keep this model unchanged when using the committed legacy index.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDINGS_PATH=data/embeddings.npz
MAX_CONTEXT_CHUNKS=4
TEMPERATURE=0.3
ALLOWED_ORIGINS=https://cg-hr-bot.vercel.app,http://localhost:3000,http://localhost:8000
BOT_NAME=HR Support Bot
BOT_GREETING=Hi! Type or talk about HR policies in Hindi, Hinglish or English.
REQUEST_TIMEOUT_SECONDS=45
VOICE_SESSION_SECONDS=300
MAX_VOICE_SESSIONS=8
VOICE_CONTEXT_MAX_CHARS=160000

# Vercel build only (public URL, no secrets):
API_BASE_URL=https://hr-chat-bot-jr1z.onrender.com
